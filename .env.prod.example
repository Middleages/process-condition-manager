# ============================================
# PCM 운영 환경 설정 (.env.prod.example)
# ============================================
# 사용법: cp .env.prod.example .env  ->  값 수정 후 docker-compose -f docker-compose.prod.yml up -d
# ============================================

# --- 데이터베이스 ---
DB_NAME=pcm
DB_USER=pcm_user
# 반드시 변경! 생성: openssl rand -base64 24
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# --- 애플리케이션 ---
# 반드시 변경! 생성: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- JWT 토큰 (선택) ---
# ACCESS_TOKEN_EXPIRE_MINUTES=480
# REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# 프론트엔드 도메인 (쉼표 구분)
CORS_ORIGINS=http://your-domain.com

# --- 프론트엔드 ---
# nginx를 통한 API 접근 경로
VITE_API_URL=http://your-domain.com/api

# --- 백업 (선택) ---
# BACKUP_RETENTION_DAYS=7
# PCM_BACKUP_DIR=./backup


# --- SSO (ADFS/OpenID) ---
FRONTEND_URL=https://pcm.fhoto.net
IDP_ENTITY_ID=https://stsds.sso.net/adfs/oauth2/authorize/
IDP_SIGNOUT_URL=https://stsds.sso.net/adfs/ls/?wa=wsignoutcleanup1.0
IDP_CLIENT_ID=CHANGE_ME_CLIENT_ID
# ADFS에서 unsupported_response_type가 나면 id_token 단독 사용
IDP_RESPONSE_TYPE=id_token
IDP_SCOPE=openid profile
SP_REDIRECT_URL=https://pcm.fhoto.net/api/auth/callback
CERTFILE_PATH=/app/certs
CERTFILE_NAME=stsds.sso.net.cer
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# form_post callback nonce 검증용 쿠키는 cross-site POST 전송 필요
NONCE_COOKIE_SAMESITE=none


# --- DEV Login bypass (개발 환경 전용) ---
# DEV_LOGIN_ENABLED=false
# DEV_LOGIN_ALLOWLIST=dev_user,qa_user
# DEV_LOGIN_DEFAULT_USERNAME=dev_user
